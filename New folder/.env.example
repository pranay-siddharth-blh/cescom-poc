# Copy to .env (git-ignored) and fill in the real values. Never commit .env.
# Consumed by dcb-ai-app/app/config.py at FastAPI startup.

# Internal OpenAI-compatible LLM gateway (the active provider, see app/llm.py; reachable over the VPN only).
# Leave these empty to run WITHOUT the model: verified queries, metric lookups, reports, definitions and
# capability notes still work; other questions get a clear "model not reachable" message.
SQL_VERIFY_MODEL=
SQL_VERIFY_BASE_URL=
SQL_VERIFY_API_KEY=
# Optional CA bundle for the gateway's TLS certificate (TLS is not verified when empty -- see app/llm.py).
AI_MODEL_CA_BUNDLE_PATH=

# Dashboard session-cookie signing key (GET /dashboard). /api/login
# accepts any non-blank username -- no password check at all -- but the
# session cookie it hands out is still HMAC-signed with this secret so
# it can't be forged/tampered with. See dcb-ai-app/app/auth.py's
# docstring. Change before this app is ever reachable by anyone but you.
SESSION_SECRET=change-this-to-a-long-random-string

# Voice mode (CLAUDE.md section 17): speech-to-text and text-to-speech on the same internal gateway (VPN only).
# Leave ASR_BASE_URL empty to hide the voice button; leave TTS_ENABLED=false for voice input with on-screen answers only.
ASR_MODEL=qwen3-asr
ASR_BASE_URL=
ASR_API_KEY=
ASR_CONTEXT_HINTS_ENABLED=true
TTS_ENABLED=false
TTS_MODEL=qwen3-tts
TTS_BASE_URL=
TTS_API_KEY=
TTS_TIMEOUT_SECONDS=20
TTS_LANGUAGE=English
# Base = clone the officer reference clip below; CustomVoice = a stock voice (TTS_VOICE)
TTS_TASK_TYPE=Base
TTS_MAX_NEW_TOKENS=2048
TTS_STREAM_ENABLED=true
TTS_X_VECTOR_ONLY_MODE=true
TTS_REF_AUDIO_PATH=voices/officer_serena.wav
# VOICE_RATE_LIMIT_PER_MINUTE=240   # transcribe / speak / filler calls per client IP per minute
# VOICE_MAX_AUDIO_BYTES=10000000    # one recording
# VOICE_COLLECT_MISHEARINGS=false   # true only with the officers' consent: logs/voice_mishearings.jsonl

# Optional (defaults shown). See CLAUDE.md section 12.
# DCB_SHOW_TECHNICAL_DETAILS=false   # true: SQL, routes, timings and /docs visible (developers only)
# DCB_RATE_LIMIT_PER_MINUTE=60       # questions / data / report calls per client IP per minute
# DCB_MAX_CONCURRENT_QUESTIONS=8     # answered at once; the rest wait DCB_QUEUE_WAIT_SECONDS, then "busy"
# DCB_QUEUE_WAIT_SECONDS=20
# DCB_MAX_REQUEST_BYTES=16384
# DCB_VERIFY_ANSWERS=true            # second model pass (reviewer) on every model-written answer
# DCB_QUERY_TIMEOUT_SECONDS=8
# DCB_MAX_ROWS=200
