# Copy to .env (git-ignored) and fill in the real values. Never commit .env.
# Consumed by dcb-ai-app/app/config.py at FastAPI startup.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=your-gemini-model-string-here

# Dashboard login gate (GET /dashboard) -- ONE shared username/password,
# not a per-user account system. See dcb-ai-app/app/auth.py's docstring
# for exactly how limited this is. Change all three before this app is
# ever reachable by anyone but you on your own machine.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-long-random-string
