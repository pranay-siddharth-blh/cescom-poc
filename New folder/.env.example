# Copy to .env (git-ignored) and fill in the real values. Never commit .env.
# Consumed by dcb-ai-app/app/config.py at FastAPI startup.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=your-gemini-model-string-here

# --- Optional second LLM provider (added for latency comparison against
# Gemini above, not a replacement) --------------------------------------
# Naming matches the sibling BLH-BESCOM project's convention
# (D:\BLH-BESCOM\.env.example): LLM_PROVIDER / LLM_BASE_URL / LLM_API_KEY /
# LLM_MODEL / LLM_TLS_VERIFY, plus LLM_TIMEOUT (new here).
#
# Leave ALL SIX blank to keep current behavior unchanged (Gemini only).
# If LLM_PROVIDER is set, every request routes through this provider
# INSTEAD of Gemini -- it's a single global switch, not per-request -- and
# LLM_BASE_URL / LLM_API_KEY / LLM_MODEL must all be filled in too (no
# default is guessed for any of them; the app fails clearly at startup if
# LLM_PROVIDER is set but any of the three is still blank).

# Only "openai" is implemented (any OpenAI-compatible /v1 chat-completions
# endpoint -- e.g. a self-hosted gateway, not necessarily OpenAI itself).
LLM_PROVIDER=openai
LLM_BASE_URL=https://your-endpoint-here/api/v1
LLM_API_KEY=your-key-here
LLM_MODEL=your-model-string-here

# true = verify the server certificate (the correct default). false = a
# deliberate opt-out for one specific self-signed-cert internal endpoint --
# NEVER set false for a real/production endpoint, it makes the connection
# MITM-able. Blank defaults to true.
LLM_TLS_VERIFY=true

# Request timeout in seconds. Blank defaults to 120.
LLM_TIMEOUT=120
