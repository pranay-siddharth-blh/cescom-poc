# Copy to .env (git-ignored) and fill in the real key.
# Consumed by app/config.py at FastAPI startup.

# REQUIRED. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override. Default matches the sibling BLH-BESCOM project's
# confirmed-live choice (checked 2026-09-05): gemini-2.5-flash-lite is
# deprecated for new API keys as of that date; gemini-3.5-flash-lite is
# its replacement. Re-verify this is still current before relying on it.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Absolute or relative-to-repo-root path to the locked star
# schema DB. Defaults to ../DCB_Star_Schema/dcb_star_schema.sqlite
# (relative to this dcb-ai-app/ folder) — never point this at a copy that
# could be written to; the app opens it read-only regardless.
DCB_DB_PATH=

# Safety caps (see app/sql_safety.py).
DCB_QUERY_TIMEOUT_SECONDS=8
DCB_MAX_ROWS=200
